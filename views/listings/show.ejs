</div>

<script>
    const listingPrice = Number("<%= listing.price %>") || 0;

    // Helper: format date as YYYY-MM-DD
    function formatDateYMD(date) {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const d = String(date.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
    }

    // Initialize Date Pickers
    document.addEventListener('DOMContentLoaded', function() {
        const checkInInput = document.getElementById('widgetCheckIn');
        const checkOutInput = document.getElementById('widgetCheckOut');
        const guestsSelect = document.getElementById('widgetGuests');

        if (checkInInput && checkOutInput) {
            const today = new Date();
            const tomorrow = new Date();
            tomorrow.setDate(today.getDate() + 1);

            const threeDaysLater = new Date();
            threeDaysLater.setDate(today.getDate() + 3);

            checkInInput.min = formatDateYMD(today);
            checkInInput.value = formatDateYMD(tomorrow);

            checkOutInput.min = formatDateYMD(tomorrow);
            checkOutInput.value = formatDateYMD(threeDaysLater);

            function updatePricing() {
                const inVal = checkInInput.value;
                const outVal = checkOutInput.value;

                if (!inVal || !outVal) return;

                const inDate = new Date(inVal);
                let outDate = new Date(outVal);

                // Auto correct if checkOut <= checkIn
                if (outDate <= inDate) {
                    outDate = new Date(inDate);
                    outDate.setDate(inDate.getDate() + 1);
                    checkOutInput.value = formatDateYMD(outDate);
                }

                // Minimum checkOut is checkIn + 1 day
                const minOut = new Date(inDate);
                minOut.setDate(inDate.getDate() + 1);
                checkOutInput.min = formatDateYMD(minOut);

                const diffTime = Math.max(1, outDate.getTime() - inDate.getTime());
                const nights = Math.max(1, Math.ceil(diffTime / (1000 * 60 * 60 * 24)));

                // Calculate pricing
                const basePrice = listingPrice * nights;
                const cleaningFee = Math.max(350, Math.round(listingPrice * 0.05));
                const serviceFee = Math.round(basePrice * 0.07);
                const taxes = Math.round((basePrice + cleaningFee + serviceFee) * 0.18);
                const totalPrice = basePrice + cleaningFee + serviceFee + taxes;

                // Update Price Breakdown UI
                const labelNights = document.getElementById('labelNightsCalc');
                if (labelNights) {
                    labelNights.textContent = `₹${listingPrice.toLocaleString('en-IN')} × ${nights} ${nights === 1 ? 'night' : 'nights'}`;
                }
                const valBase = document.getElementById('valBasePrice');
                if (valBase) valBase.textContent = `₹${basePrice.toLocaleString('en-IN')}`;

                const valCleaning = document.getElementById('valCleaningFee');
                if (valCleaning) valCleaning.textContent = `₹${cleaningFee.toLocaleString('en-IN')}`;

                const valService = document.getElementById('valServiceFee');
                if (valService) valService.textContent = `₹${serviceFee.toLocaleString('en-IN')}`;

                const valTax = document.getElementById('valTaxes');
                if (valTax) valTax.textContent = `₹${taxes.toLocaleString('en-IN')}`;

                const valTotal = document.getElementById('valTotalPrice');
                if (valTotal) valTotal.textContent = `₹${totalPrice.toLocaleString('en-IN')}`;

                // Sync with modal hidden inputs
                const hiddenCheckIn = document.getElementById('modalHiddenCheckIn');
                const hiddenCheckOut = document.getElementById('modalHiddenCheckOut');
                const hiddenAdults = document.getElementById('modalHiddenAdults');
                const modalTotal = document.getElementById('modalTotalDueDisplay');
                const modalSummary = document.getElementById('modalTripDatesSummary');

                if (hiddenCheckIn) hiddenCheckIn.value = inVal;
                if (hiddenCheckOut) hiddenCheckOut.value = outVal;
                if (hiddenAdults && guestsSelect) hiddenAdults.value = guestsSelect.value;
                if (modalTotal) modalTotal.textContent = `₹${totalPrice.toLocaleString('en-IN')}`;

                if (modalSummary) {
                    const guestsText = guestsSelect ? `${guestsSelect.value} ${guestsSelect.value === '1' ? 'guest' : 'guests'}` : '1 guest';
                    modalSummary.innerHTML = `
                        <i class="fa-regular fa-calendar me-1"></i>
                        ${inDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short' })} – 
                        ${outDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })} 
                        (${nights} ${nights === 1 ? 'night' : 'nights'}) · ${guestsText}
                    `;
                }
            }

            checkInInput.addEventListener('change', updatePricing);
            checkOutInput.addEventListener('change', updatePricing);
            if (guestsSelect) guestsSelect.addEventListener('change', updatePricing);

            // Initial calculation
            updatePricing();
        }

        // Initialize Wishlist State
        const wishlistBtn = document.getElementById('btnWishlist');
        const listingId = "<%= listing._id %>";
        if (wishlistBtn && listingId) {
            const savedList = JSON.parse(localStorage.getItem('wanderlust_wishlist') || '[]');
            if (savedList.includes(listingId)) {
                wishlistBtn.classList.add('active');
                wishlistBtn.innerHTML = '<i class="fa-solid fa-heart" style="color: #E61E4D;"></i>';
            }
        }
    });

    // Razorpay and Payment Method Toggle
    let activePaymentMethod = 'razorpay';

    function selectPaymentMethod(method, cardElement) {
        activePaymentMethod = method;
        document.querySelectorAll('.payment-option-card').forEach(el => el.classList.remove('selected'));
        cardElement.classList.add('selected');
        const radio = cardElement.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;

        const btnRazorpay = document.getElementById('btnSubmitRazorpay');
        const btnCash = document.getElementById('btnSubmitCash');

        if (method === 'razorpay') {
            if (btnRazorpay) btnRazorpay.style.display = 'inline-flex';
            if (btnCash) btnCash.style.display = 'none';
        } else {
            if (btnRazorpay) btnRazorpay.style.display = 'none';
            if (btnCash) btnCash.style.display = 'inline-flex';
        }
    }

    // Razorpay Instant Online Payment Handler
    async function handleRazorpayPayment() {
        const checkIn = document.getElementById('modalHiddenCheckIn')?.value || document.getElementById('widgetCheckIn')?.value;
        const checkOut = document.getElementById('modalHiddenCheckOut')?.value || document.getElementById('widgetCheckOut')?.value;
        const adults = document.getElementById('modalHiddenAdults')?.value || document.getElementById('widgetGuests')?.value || 1;
        const children = document.getElementById('modalHiddenChildren')?.value || 0;


        const form = document.getElementById('bookingCheckoutForm');
        if (!form) return;

        const guestName = form.querySelector('input[name="booking[guestName]"]')?.value;
        const guestEmail = form.querySelector('input[name="booking[guestEmail]"]')?.value;
        const guestPhone = form.querySelector('input[name="booking[guestPhone]"]')?.value;
        const specialRequests = form.querySelector('textarea[name="booking[specialRequests]"]')?.value || '';

        if (!guestName || !guestEmail || !guestPhone) {
            alert('Please fill in your name, email, and phone number to continue.');
            return;
        }

        const btn = document.getElementById('btnSubmitRazorpay');
        const originalText = btn ? btn.innerHTML : '';
        if (btn) {
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Opening Razorpay...';
            btn.disabled = true;
        }

        try {
            // 1. Create order on server
            const orderRes = await fetch('/listing/<%= listing._id %>/create-razorpay-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ checkIn, checkOut, adults, children })
            });

            const orderData = await orderRes.json();
            if (!orderData.success) {
                alert(orderData.message || 'Could not initiate Razorpay order.');
                if (btn) { btn.innerHTML = originalText; btn.disabled = false; }
                return;
            }

            // 2. Open Razorpay Checkout modal
            const options = {
                key: orderData.keyId,
                amount: orderData.amount,
                currency: orderData.currency || "INR",
                name: "Stayvista Stays",
                description: `Reservation for ${orderData.listingTitle || 'Stay'}`,
                image: "<%= (listing.image && listing.image.url) ? listing.image.url : '' %>",
                order_id: orderData.isSimulated ? undefined : orderData.orderId,
                prefill: {
                    name: guestName,
                    email: guestEmail,
                    contact: guestPhone
                },
                theme: {
                    color: "#E61E4D"
                },
                handler: async function (response) {
                    showNotification('⚡ Verifying Razorpay payment...');
                    
                    const verifyRes = await fetch('/listing/<%= listing._id %>/verify-payment', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            razorpay_order_id: response.razorpay_order_id || orderData.orderId,
                            razorpay_payment_id: response.razorpay_payment_id || `pay_${Date.now()}`,
                            razorpay_signature: response.razorpay_signature || 'simulated_sig',
                            checkIn,
                            checkOut,
                            adults,
                            children,
                            guestName,
                            guestEmail,
                            guestPhone,
                            specialRequests
                        })
                    });

                    const verifyData = await verifyRes.json();
                    if (verifyData.success) {
                        window.location.href = verifyData.redirectUrl;
                    } else {
                        alert(verifyData.message || 'Payment verification failed.');
                        if (btn) { btn.innerHTML = originalText; btn.disabled = false; }
                    }
                },
                modal: {
                    ondismiss: function() {
                        if (btn) { btn.innerHTML = originalText; btn.disabled = false; }
                    }
                }
            };

            // Check if Razorpay SDK is available
            if (typeof Razorpay !== 'undefined') {
                const rzp = new Razorpay(options);
                rzp.open();
            } else {
                // If offline/script blocked, execute fallback handler
                alert("Razorpay checkout is simulating in demo mode...");
                options.handler({
                    razorpay_order_id: orderData.orderId,
                    razorpay_payment_id: `pay_demo_${Date.now()}`,
                    razorpay_signature: "demo_sig"
                });
            }
        } catch (err) {
            console.error('Razorpay Error:', err);
            alert('Something went wrong initiating Razorpay. Please try again or select Pay on Arrival.');
            if (btn) { btn.innerHTML = originalText; btn.disabled = false; }
        }
    }

    // Copy Share URL
    function copyShareUrl() {
        navigator.clipboard.writeText(window.location.href).then(() => {
            const label = document.getElementById('copyShareLabel');
            if (label) label.textContent = 'Copied to clipboard!';
            showNotification('🔗 Listing link copied to clipboard!');
            setTimeout(() => {
                if (label) label.textContent = 'Copy direct link to clipboard';
            }, 2500);
        });
    }

    // Toggle Wishlist
    function toggleWishlist(listingId) {
        let savedList = JSON.parse(localStorage.getItem('wanderlust_wishlist') || '[]');
        const btn = document.getElementById('btnWishlist');
        
        if (savedList.includes(listingId)) {
            savedList = savedList.filter(id => id !== listingId);
            if (btn) {
                btn.classList.remove('active');
                btn.innerHTML = '<i class="fa-regular fa-heart"></i>';
            }
            showNotification('Removed from your wishlist');
        } else {
            savedList.push(listingId);
            if (btn) {
                btn.classList.add('active');
                btn.innerHTML = '<i class="fa-solid fa-heart" style="color: #E61E4D;"></i>';
            }
            showNotification('❤️ Saved to your wishlist!');
        }
        localStorage.setItem('wanderlust_wishlist', JSON.stringify(savedList));
    }

    // Function to generate star display (only filled stars visible)
    function renderStars(rating) {
        let starsHtml = '';
        for (let i = 1; i <= 5; i++) {
            if (i <= rating) {
                starsHtml += '<span class="star">★</span>';
            } else {
                starsHtml += '<span class="star-empty">★</span>';
            }
        }
        return starsHtml;
    }

    // Initialize all star ratings display
    document.querySelectorAll('.stars-display').forEach(element => {
        const rating = parseInt(element.getAttribute('data-rating'));
        if (rating && rating > 0) {
            element.innerHTML = renderStars(rating);
        } else {
            element.innerHTML = renderStars(0);
        }
    });

    // Modern Toast Notification function
    function showNotification(message) {
        const notification = document.createElement('div');
        notification.innerHTML = `
            <div style="position: fixed; bottom: 25px; right: 25px; background: #111827; color: white; padding: 0.9rem 1.6rem; border-radius: 9999px; box-shadow: 0 10px 30px rgba(0,0,0,0.25); z-index: 9999; animation: slideIn 0.3s ease; display: flex; align-items: center; gap: 0.6rem; font-weight: 500; font-size: 0.95rem;">
                <i class="fa-solid fa-circle-check" style="color: #10b981;"></i>
                ${message}
            </div>
        `;
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.style.opacity = '0';
            notification.style.transform = 'translateY(10px)';
            notification.style.transition = 'all 0.3s ease';
            setTimeout(() => notification.remove(), 300);
        }, 2500);
    }

    // Add animation styles
    const style = document.createElement('style');
    style.textContent = `
        @keyframes slideIn {
            from {
                transform: translateY(20px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }
    `;
    document.head.appendChild(style);
</script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
