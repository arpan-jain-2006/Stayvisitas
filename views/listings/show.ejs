<% layout("/layouts/boilerplate")%>
<style>
    /* Premium Show Page Styles */
    .show-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    /* Hero Section */
    .hero-section {
        margin-bottom: 2rem;
    }

    .hero-title {
        font-size: 2.5rem;
        font-weight: 700;
        background: linear-gradient(135deg, #222, #ff385c);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.5rem;
    }

    .hero-location {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #717171;
        font-size: 1rem;
        flex-wrap: wrap;
    }

    .hero-location i {
        color: #ff385c;
    }

    /* Image Gallery - Clean Version */
    .image-gallery {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 0.5rem;
        border-radius: 24px;
        overflow: hidden;
        margin-bottom: 2rem;
        height: 500px;
        background: #f0f2f4;
    }

    .gallery-main {
        grid-column: 1 / 2;
        grid-row: 1 / 3;
        height: 100%;
        overflow: hidden;
    }

    .gallery-main img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    /* Right side images - 2 images stacked */
    .gallery-top-right {
        grid-column: 2 / 4;
        grid-row: 1 / 2;
        overflow: hidden;
    }

    .gallery-bottom-right {
        grid-column: 2 / 4;
        grid-row: 2 / 3;
        overflow: hidden;
    }

    .gallery-top-right img,
    .gallery-bottom-right img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transition: transform 0.3s ease;
    }

    .gallery-top-right:hover img,
    .gallery-bottom-right:hover img,
    .gallery-main:hover img {
        transform: scale(1.05);
    }

    /* For 4 images layout (alternative) */
    .image-gallery-four {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
        border-radius: 24px;
        overflow: hidden;
        margin-bottom: 2rem;
        height: 400px;
    }

    .image-gallery-four .gallery-item {
        overflow: hidden;
    }

    .image-gallery-four .gallery-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transition: transform 0.3s ease;
    }

    .image-gallery-four .gallery-item:hover img {
        transform: scale(1.05);
    }

    /* Content Layout */
    .content-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 3rem;
        margin-bottom: 3rem;
    }

    /* Host Info Card */
    .host-card {
        background: white;
        border-radius: 20px;
        padding: 1.5rem;
        box-shadow: 0 6px 16px rgba(0,0,0,0.08);
        border: 1px solid #eaeaea;
    }

    .host-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #ff385c, #e61e4d);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: white;
        margin-bottom: 1rem;
    }

    .host-name {
        font-size: 1.3rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .host-badge {
        display: inline-block;
        background: #f0f2f4;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        margin-top: 0.5rem;
    }

    /* Listing Details */
    .detail-section {
        margin-bottom: 2rem;
    }

    .detail-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .detail-description {
        color: #222;
        line-height: 1.6;
        font-size: 1rem;
    }

    /* Amenities Grid */
    .amenities-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin-top: 1rem;
    }

    .amenity-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        background: #f8f9fa;
        border-radius: 12px;
    }

    .amenity-item i {
        font-size: 1.2rem;
        color: #ff385c;
        width: 24px;
    }

    /* Price Card (Right Sidebar) */
    .price-card {
        background: white;
        border-radius: 24px;
        padding: 1.75rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        position: sticky;
        top: 6.5rem;
        border: 1px solid #e5e7eb;
        transition: box-shadow 0.3s ease;
    }

    .price-header-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 1rem;
    }

    .price-amount {
        font-size: 1.75rem;
        font-weight: 800;
        color: #111827;
    }

    .price-night {
        font-size: 0.95rem;
        font-weight: 500;
        color: #6b7280;
    }

    .rating-badge-mini {
        font-size: 0.9rem;
        font-weight: 600;
        color: #222;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .rare-find-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: #fff1f2;
        border: 1px solid #ffe4e6;
        color: #e11d48;
        padding: 0.5rem 0.85rem;
        border-radius: 12px;
        font-size: 0.82rem;
        font-weight: 600;
        margin-bottom: 1.25rem;
    }

    .booking-inputs-box {
        border: 1.5px solid #d1d5db;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 1rem;
        background: white;
        box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }

    .booking-dates-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-bottom: 1.5px solid #d1d5db;
    }

    .date-cell {
        padding: 0.6rem 0.8rem;
    }

    .date-cell:first-child {
        border-right: 1.5px solid #d1d5db;
    }

    .date-cell-label {
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #111827;
        display: block;
        margin-bottom: 2px;
    }

    .date-cell-input {
        width: 100%;
        border: none;
        outline: none;
        font-size: 0.85rem;
        font-weight: 600;
        color: #1f2937;
        background: transparent;
        cursor: pointer;
    }

    .guests-row {
        padding: 0.6rem 0.8rem;
    }

    .guests-row-select {
        width: 100%;
        border: none;
        outline: none;
        font-size: 0.9rem;
        font-weight: 600;
        color: #1f2937;
        background: transparent;
        cursor: pointer;
    }

    .action-buttons {
        display: flex;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .btn-reserve-main {
        background: linear-gradient(135deg, #FF385C, #E61E4D);
        color: white;
        border: none;
        padding: 0.95rem 1.5rem;
        border-radius: 14px;
        font-weight: 700;
        font-size: 1.05rem;
        flex: 1;
        cursor: pointer;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        box-shadow: 0 4px 14px rgba(230, 30, 77, 0.35);
    }

    .btn-reserve-main:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(230, 30, 77, 0.45);
        color: white;
    }

    .btn-wishlist-toggle {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        border: 1.5px solid #e5e7eb;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: #6b7280;
        cursor: pointer;
        transition: all 0.2s;
        flex-shrink: 0;
    }

    .btn-wishlist-toggle:hover,
    .btn-wishlist-toggle.active {
        color: #E61E4D;
        border-color: #fecdd3;
        background: #fff1f2;
    }

    .wont-charge-notice {
        text-align: center;
        font-size: 0.85rem;
        color: #6b7280;
        margin: 0.75rem 0 1.25rem;
    }

    .price-breakdown-live {
        border-top: 1px solid #f3f4f6;
        padding-top: 1.25rem;
    }

    .live-calc-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.95rem;
        color: #4b5563;
        margin-bottom: 0.65rem;
    }

    .live-calc-row.total-row {
        border-top: 1px solid #e5e7eb;
        padding-top: 0.85rem;
        margin-top: 0.85rem;
        font-size: 1.15rem;
        font-weight: 800;
        color: #111827;
    }

    /* Highlights Section */
    .highlights-list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin: 1.75rem 0;
        padding: 1.5rem 0;
        border-top: 1px solid #f3f4f6;
        border-bottom: 1px solid #f3f4f6;
    }

    .highlight-item {
        display: flex;
        gap: 1.25rem;
        align-items: flex-start;
    }

    .highlight-icon {
        font-size: 1.4rem;
        color: #111827;
        width: 28px;
        text-align: center;
        padding-top: 2px;
    }

    .highlight-title {
        font-weight: 700;
        font-size: 1rem;
        color: #111827;
        margin-bottom: 0.15rem;
    }

    .highlight-desc {
        color: #6b7280;
        font-size: 0.9rem;
        line-height: 1.4;
    }

    /* Modal styling */
    .checkout-modal-content {
        border-radius: 28px;
        border: none;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0,0,0,0.25);
    }

    .payment-option-card {
        border: 2px solid #e5e7eb;
        border-radius: 14px;
        padding: 0.9rem 1.2rem;
        background: white;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
    }

    .payment-option-card.selected,
    .payment-option-card:hover {
        border-color: #E61E4D;
        background: #fff5f5;
    }

    /* Reviews Section */
    .reviews-header {
        display: flex;
        align-items: center;

        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .rating-summary {
        background: #f8f9fa;
        padding: 1rem 1.5rem;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .rating-summary i {
        color: #ff385c;
        font-size: 1.3rem;
    }

    .review-card {
        background: white;
        border-radius: 16px;
        padding: 1.25rem;
        margin-bottom: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        transition: all 0.2s ease;
        border: 1px solid #eaeaea;
    }

    .review-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0,0,0,0.1);
    }

    .review-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .review-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #ff385c;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 600;
        font-size: 1.2rem;
    }

    .review-author {
        font-weight: 600;
        font-size: 1rem;
    }

    .review-date {
        font-size: 0.8rem;
        color: #717171;
    }

    .review-comment {
        color: #222;
        line-height: 1.5;
        margin-top: 0.5rem;
    }

    /* Review Form */
    .review-form-container {
        background: #f8f9fa;
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .review-form-title {
        font-size: 1.3rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    /* Simple Star Rating Styles */
    .star-rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .star-rating input {
        display: none;
    }

    .star-rating label {
        font-size: 2rem;
        color: #ddd;
        cursor: pointer;
        transition: color 0.2s ease;
    }

    .star-rating label:before {
        content: "★";
    }

    .star-rating input:checked ~ label,
    .star-rating label:hover,
    .star-rating label:hover ~ label {
        color: #ff385c;
    }

    /* Static Star Display for Reviews */
    .stars-display {
        display: inline-flex;
        gap: 0.2rem;
        font-size: 1rem;
        letter-spacing: 2px;
    }
    
    .stars-display .star {
        color: #ff385c;
    }
    
    .stars-display .star-empty {
        color: #ddd;
    }

    /* Delete Review Button */
    .delete-review-btn {
        background: none;
        border: none;
        color: #ff385c;
        font-size: 0.85rem;
        padding: 0;
        margin-top: 0.75rem;
        cursor: pointer;
        transition: color 0.2s ease;
    }

    .delete-review-btn:hover {
        color: #e61e4d;
        text-decoration: underline;
    }

    /* Owner Action Buttons */
    .owner-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
    }

    .btn-edit, .btn-delete {
        padding: 0.6rem 1.2rem;
        border-radius: 10px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-edit {
        background: #222;
        color: white;
        border: none;
    }

    .btn-edit:hover {
        background: #ff385c;
        transform: translateY(-2px);
    }

    .btn-delete {
        background: white;
        color: #ff385c;
        border: 1px solid #ff385c;
    }

    .btn-delete:hover {
        background: #ff385c;
        color: white;
    }

    /* Responsive */
    @media (max-width: 992px) {
        .content-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .image-gallery {
            grid-template-columns: 1fr;
            grid-template-rows: auto auto;
            height: auto;
        }

        .gallery-main {
            grid-column: 1;
            grid-row: 1;
            height: 400px;
        }

        .gallery-top-right,
        .gallery-bottom-right {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .show-container {
            padding: 0 1rem;
        }

        .hero-title {
            font-size: 1.8rem;
        }

        .gallery-main {
            height: 300px;
        }

        .amenities-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="show-container">
    <!-- Hero Section -->
    <div class="hero-section d-flex justify-content-between align-items-end flex-wrap gap-3">
        <div>
            <h1 class="hero-title"><%= listing.title %></h1>
            <div class="hero-location">
                <i class="fa-solid fa-location-dot" style="color: #E61E4D;"></i>
                <span><%= listing.location %>, <%= listing.country %></span>
                <span class="mx-2">•</span>
                <i class="fa-solid fa-star text-danger"></i>
                <span>4.98 (<%= listing.reviews.length %> reviews)</span>
                <span class="mx-2">•</span>
                <span class="badge bg-light text-dark border">
                    <i class="fa-solid fa-medal text-warning me-1"></i> Superhost
                </span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-dark rounded-pill px-3 py-1 btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#shareModal">
                <i class="fa-solid fa-arrow-up-from-bracket me-1"></i> Share
            </button>
            <button class="btn btn-outline-danger rounded-pill px-3 py-1 btn-sm fw-semibold" onclick="toggleWishlist('<%= listing._id %>')">
                <i class="fa-regular fa-heart me-1"></i> Save
            </button>
        </div>
    </div>

    <!-- Image Gallery - Clean 3 Image Layout (1 large + 2 small) -->
    <div class="image-gallery">
        <!-- Main Large Image -->
        <div class="gallery-main">
            <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
        </div>
        
        <!-- Top Right Small Image -->
        <div class="gallery-top-right">
            <img src="https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?w=400" alt="Gallery 1">
        </div>
        
        <!-- Bottom Right Small Image -->
        <div class="gallery-bottom-right">
            <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=400" alt="Gallery 2">
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="content-grid">
        <!-- Left Column -->
        <div>
            <!-- Host Info -->
            <div class="host-card mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="host-avatar mb-0">
                        <i class="fa-regular fa-user"></i>
                    </div>
                    <div>
                        <div class="host-name mb-0">Hosted by <%= (listing.owner && listing.owner.username) ? listing.owner.username : 'Superhost' %></div>
                        <div class="host-badge">
                            <i class="fa-solid fa-medal text-warning me-1"></i> Superhost · Verified Partner
                        </div>
                    </div>
                </div>
                <button class="btn btn-outline-dark btn-sm rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#contactHostModal">
                    <i class="fa-regular fa-comment-dots me-1 text-danger"></i> Contact Host
                </button>
            </div>


            <!-- Property Highlights -->
            <div class="highlights-list">
                <div class="highlight-item">
                    <div class="highlight-icon"><i class="fa-solid fa-key" style="color: #E61E4D;"></i></div>
                    <div>
                        <div class="highlight-title">Self check-in</div>
                        <div class="highlight-desc">Check yourself in with the smart keypad lock upon arrival.</div>
                    </div>
                </div>
                <div class="highlight-item">
                    <div class="highlight-icon"><i class="fa-solid fa-medal" style="color: #E61E4D;"></i></div>
                    <div>
                        <div class="highlight-title">Experienced Superhost</div>
                        <div class="highlight-desc"><%= (listing.owner && listing.owner.username) ? listing.owner.username : 'Host' %> has 100% 5-star ratings from recent guests.</div>
                    </div>
                </div>
                <div class="highlight-item">
                    <div class="highlight-icon"><i class="fa-solid fa-location-dot" style="color: #E61E4D;"></i></div>
                    <div>
                        <div class="highlight-title">Prime Location</div>
                        <div class="highlight-desc">98% of recent guests gave the location a 5-star rating.</div>
                    </div>
                </div>
                <div class="highlight-item">
                    <div class="highlight-icon"><i class="fa-solid fa-shield-heart" style="color: #E61E4D;"></i></div>
                    <div>
                        <div class="highlight-title">Stayvista Protection Guarantee</div>
                        <div class="highlight-desc">Every booking includes comprehensive coverage for booking accuracy & host support.</div>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="detail-section">
                <h2 class="detail-title">About this place</h2>
                <p class="detail-description"><%= listing.description %></p>
            </div>

            <!-- Sleeping Arrangements -->
            <div class="detail-section">
                <h2 class="detail-title">Where you'll sleep</h2>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-4 border">
                            <i class="fa-solid fa-bed fs-4 mb-2" style="color: #E61E4D;"></i>
                            <div class="fw-bold">Bedroom 1</div>
                            <small class="text-muted">1 Queen bed · Luxury linens</small>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-4 border">
                            <i class="fa-solid fa-couch fs-4 mb-2" style="color: #E61E4D;"></i>
                            <div class="fw-bold">Bedroom 2 / Living</div>
                            <small class="text-muted">1 Double sofa bed</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Amenities -->
            <div class="detail-section">
                <h2 class="detail-title">What this place offers</h2>
                <div class="amenities-grid">
                    <div class="amenity-item">
                        <i class="fa-solid fa-wifi"></i>
                        <span>High-Speed WiFi</span>
                    </div>
                    <div class="amenity-item">
                        <i class="fa-solid fa-kitchen-set"></i>
                        <span>Equipped Kitchen</span>
                    </div>
                    <div class="amenity-item">
                        <i class="fa-solid fa-water-ladder"></i>
                        <span>Private / Shared Pool</span>
                    </div>
                    <div class="amenity-item">
                        <i class="fa-solid fa-car"></i>
                        <span>Free On-premises Parking</span>
                    </div>
                    <div class="amenity-item">
                        <i class="fa-solid fa-wind"></i>
                        <span>Air Conditioning</span>
                    </div>
                    <div class="amenity-item">
                        <i class="fa-solid fa-tv"></i>
                        <span>Smart 4K TV with OTT</span>
                    </div>
                </div>
            </div>

            <!-- Location Section -->
            <div class="detail-section">
                <h2 class="detail-title">Where you'll be</h2>
                <div class="p-4 bg-light rounded-4 border">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="fa-solid fa-location-dot text-danger fs-5"></i>
                        <span class="fw-bold fs-5"><%= listing.location %>, <%= listing.country %></span>
                    </div>
                    <p class="text-muted small mb-3">Quiet, scenic neighborhood with easy access to local cafes, sights, and transportation.</p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-dark btn-sm rounded-pill px-3" onclick="navigator.clipboard.writeText('<%= listing.location %>, <%= listing.country %>'); showNotification('Address copied to clipboard!');">
                            <i class="fa-regular fa-copy me-1"></i> Copy Address
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column - Airbnb Reserve Card -->
        <div>
            <div class="price-card">
                <div class="rare-find-badge">
                    <i class="fa-solid fa-fire text-danger"></i>
                    <span>Rare find! This place is usually fully booked.</span>
                </div>

                <div class="price-header-row">
                    <div>
                        <span class="price-amount" id="displayNightlyPrice">₹<%= listing.price.toLocaleString("en-IN") %></span>
                        <span class="price-night"> / night</span>
                    </div>
                    <div class="rating-badge-mini">
                        <i class="fa-solid fa-star text-danger"></i>
                        <span>4.98</span>
                        <span class="text-muted">· (<%= listing.reviews.length %>)</span>
                    </div>
                </div>

                <!-- Airbnb Inputs Box -->
                <div class="booking-inputs-box">
                    <div class="booking-dates-row">
                        <div class="date-cell">
                            <label class="date-cell-label" for="widgetCheckIn">CHECK-IN</label>
                            <input type="date" id="widgetCheckIn" class="date-cell-input" />
                        </div>
                        <div class="date-cell">
                            <label class="date-cell-label" for="widgetCheckOut">CHECKOUT</label>
                            <input type="date" id="widgetCheckOut" class="date-cell-input" />
                        </div>
                    </div>
                    <div class="guests-row">
                        <label class="date-cell-label" for="widgetGuests">GUESTS</label>
                        <select id="widgetGuests" class="guests-row-select">
                            <option value="1" selected>1 guest</option>
                            <option value="2">2 guests</option>
                            <option value="3">3 guests</option>
                            <option value="4">4 guests</option>
                            <option value="5">5+ guests</option>
                        </select>
                    </div>
                </div>

                <!-- Reserve Action Buttons -->
                <div class="action-buttons">
                    <% if (currUser) { %>
                        <button class="btn-reserve-main" type="button" data-bs-toggle="modal" data-bs-target="#reserveModal" id="btnOpenReserveModal">
                            <i class="fa-solid fa-calendar-check"></i> Reserve Now
                        </button>
                    <% } else { %>
                        <a href="/login" class="btn-reserve-main text-decoration-none">
                            <i class="fa-solid fa-arrow-right-to-bracket"></i> Login to Reserve
                        </a>
                    <% } %>

                    <button class="btn-wishlist-toggle" id="btnWishlist" title="Save to wishlist" onclick="toggleWishlist('<%= listing._id %>')">
                        <i class="fa-regular fa-heart"></i>
                    </button>
                </div>

                <div class="wont-charge-notice">You won't be charged yet</div>

                <!-- Live Dynamic Price Breakdown -->
                <div class="price-breakdown-live" id="livePriceBreakdown">
                    <div class="live-calc-row">
                        <span id="labelNightsCalc">₹<%= listing.price.toLocaleString("en-IN") %> × 2 nights</span>
                        <span class="fw-semibold" id="valBasePrice">₹<%= (listing.price * 2).toLocaleString("en-IN") %></span>
                    </div>
                    <div class="live-calc-row">
                        <span>Cleaning fee</span>
                        <span class="fw-semibold" id="valCleaningFee">₹500</span>
                    </div>
                    <div class="live-calc-row">
                        <span>Stayvista service fee (7%)</span>
                        <span class="fw-semibold" id="valServiceFee">₹<%= Math.round(listing.price * 2 * 0.07).toLocaleString("en-IN") %></span>
                    </div>
                    <div class="live-calc-row">
                        <span>Taxes & GST (18%)</span>
                        <span class="fw-semibold" id="valTaxes">₹<%= Math.round(((listing.price * 2) + 500 + (listing.price * 2 * 0.07)) * 0.18).toLocaleString("en-IN") %></span>
                    </div>
                    <div class="live-calc-row total-row">
                        <span>Total (INR)</span>
                        <span style="color: #E61E4D;" id="valTotalPrice">₹0</span>
                    </div>
                </div>

                <!-- Cancellation Policy Reminder -->
                <div class="mt-3 pt-3 border-top text-muted small">
                    <i class="fa-solid fa-shield-halved text-success me-1"></i>
                    <b>Free cancellation</b> up to 48 hours before check-in.
                </div>
                
                <% if (currUser && currUser._id && listing.owner && listing.owner._id && currUser._id.toString() === listing.owner._id.toString()) { %>
                    <div class="owner-actions mt-4 pt-3 border-top">
                        <a href="/listing/<%=listing._id%>/edit" class="btn-edit">
                            <i class="fa-regular fa-pen-to-square"></i> Edit Listing
                        </a>
                        <form method="post" action="/listing/<%=listing._id%>?_method=DELETE" style="display: inline;">
                            <button class="btn-delete" onclick="return confirm('Are you sure you want to delete this listing?')">
                                <i class="fa-regular fa-trash-can"></i> Delete
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Airbnb Reserve & Checkout Modal -->
